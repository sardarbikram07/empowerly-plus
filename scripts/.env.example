# scripts/.env.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to scripts/.env and fill in real values.
# Used by scripts/seed.js (loaded via dotenv).
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=

# Target database name
MONGODB_DB=empowerlyplus
