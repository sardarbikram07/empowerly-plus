# ── Secrets & environment files ────────────────────────────────────────────────
# Never commit .env files containing real secrets.
# Use .env.example as a template; fill in values locally.
.env
.env.*
*.env
!.env.example

# ── Java / Maven ───────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
!**/src/main/**
!**/src/test/**
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── Node.js ────────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
scripts/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# ── Frontend build output ──────────────────────────────────────────────────────
dist/
frontend/.vite/

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
