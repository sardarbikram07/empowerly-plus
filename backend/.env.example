# backend/.env.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# This file is committed; backend/.env is gitignored.
#
# Spring Boot reads these via:
#   spring.config.import=optional:file:.env[.properties]
# which is set in backend/src/main/resources/application.yml
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (from Atlas UI → Connect → Drivers)
MONGODB_URI=

# Target database name
MONGODB_DB=empowerlyplus

# JWT signing secret – use a random string of at least 32 characters
JWT_SECRET=

# Token lifetime in minutes (default: 60)
JWT_EXPIRY_MINUTES=60

# Google Gemini API key (for AI features in later tasks)
GEMINI_API_KEY=

# Allowed CORS origin for the frontend (no trailing slash)
CORS_ORIGIN=http://localhost:5173
