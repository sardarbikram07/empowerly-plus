# frontend/.env.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to frontend/.env.local and fill in real values.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# Full URL of the backend API (no trailing slash).
# In local development you can leave this empty and rely on Vite's /api proxy.
# In production set it to e.g. https://api.empowerly.example.com
VITE_API_URL=
